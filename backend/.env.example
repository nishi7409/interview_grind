# Backend configuration (all optional; defaults shown)

# Comma-separated allowed CORS origins for the React dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Swap in a larger dataset by pointing these at absolute JSON paths
# PROBLEMS_PATH=/abs/path/to/problems.json
# SYSTEM_DESIGN_PATH=/abs/path/to/system_design.json

# Sandbox limits
SANDBOX_TIMEOUT_SECONDS=6
SANDBOX_MAX_OUTPUT_BYTES=65536
